{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "discord",
  "description": "Lets Driftcord's injected layer on Discord's own app pages talk to the app (mods, updates, screen share). Only Driftcord's own commands are exposed; no file system, shell or plugin APIs. Other discord.com subdomains (support, blog, status pages) get nothing.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://discord.com/*", "https://canary.discord.com/*", "https://ptb.discord.com/*"]
  },
  "permissions": [
    "allow-get-info",
    "allow-set-mod",
    "allow-restart-app",
    "allow-check-update",
    "allow-install-update",
    "allow-mod-fetch",
    "allow-set-lean",
    "allow-set-memory",
    "allow-set-background",
    "allow-set-in-call",
    "allow-open-link",
    "allow-set-badge",
    "allow-reveal-download",
    "allow-save-url",
    "allow-read-net-events",
    "allow-log-page-event",
    "allow-write-diag",
    "allow-capture-sources",
    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-ack",
    "allow-capture-configure",
    "allow-win-drag",
    "allow-win-resize",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-is-maximized",
    "allow-win-close"
  ]
}
